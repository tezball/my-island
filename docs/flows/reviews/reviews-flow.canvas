	"nodes":[
		{"id":"group","type":"group","x":-700,"y":-400,"width":2660,"height":1700,"color":"4","label":"Reviews"},
		{"id":"title","type":"text","text":"# Reviews Flow\n\nSubmitting and viewing campsite reviews.","x":0,"y":-280,"width":450,"height":120,"color":"6"},
		{"id":"legend","type":"text","text":"## Event Legend\n\n**Green (5)**: Kafka Domain Events\n**Blue (4)**: UI-Only Events\n**Red (1)**: Kafka Error Events","x":500,"y":-280,"width":280,"height":140,"color":"6"},
