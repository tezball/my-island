		{"id":"review-detail-kafka","type":"text","text":"**Kafka Events:**\n- `onHelpful` → `review.marked_helpful`\n  - Ranking algorithm, Analytics\n- `onReport` → `review.reported`\n  - Moderation queue","x":1420,"y":540,"width":340,"height":120,"color":"5"},
		{"id":"review-detail","type":"text","text":"## Review Detail\n\n**Screen:** ReviewDetailPage","x":1150,"y":320,"width":300,"height":80,"color":"4"},
		{"id":"review-detail-ui","type":"text","text":"**UI Events:**\n- `onViewPhotos`: See review photos\n- `onViewProfile`: See reviewer profile\n- `onBack`: Return to list","x":1000,"y":540,"width":300,"height":100,"color":"4"},
		{"id":"submit-review-kafka","type":"text","text":"**Kafka Events:**\n- `onSubmit` → `review.submitted`\n  - Moderation queue, Host notification, Analytics\n- `onSaveDraft` → `review.draft_saved`\n  - Reminder scheduling","x":-98,"y":620,"width":380,"height":120,"color":"5"},
		{"id":"review-guidelines","type":"text","text":"## Review Guidelines\n\n- Minimum 20 characters\n- Maximum 5 photos\n- Rate: 1-5 stars\n- Categories: Cleanliness, Location, Value, Facilities\n- Moderation before publish","x":190,"y":800,"width":460,"height":220,"color":"2"},
		{"id":"reviews-list-ui","type":"text","text":"**UI Events:**\n- `onReviewSelect`: View full review\n- `onSort`: Sort by date/rating\n- `onFilter`: Filter by rating\n- `onLoadMore`: Pagination\n- `onWriteReview`: Add your review","x":720,"y":800,"width":360,"height":210,"color":"4"},
		{"id":"reviews-list","type":"text","text":"## Reviews List\n\n**Screen:** ReviewsListPage","x":480,"y":460,"width":300,"height":80,"color":"4"},
		{"id":"review-submitted-ui","type":"text","text":"**UI Events:**\n- `onDone`: Return to bookings\n- `onViewReview`: See published review\n- `onShare`: Share review","x":950,"y":-10,"width":400,"height":190,"color":"4"},
		{"id":"entry-points","type":"text","text":"## Entry Points\n\n1. **Post-stay email** - Review reminder\n2. **My Bookings** - Past booking card\n3. **Campsite Detail** - All reviews section\n4. **Push notification** - Review prompt","x":-580,"y":15,"width":330,"height":250,"color":"3"},
		{"id":"submit-review-ui","type":"text","text":"**UI Events:**\n- `onRatingSelect`: Choose star rating\n- `onCategoryRate`: Rate specific aspects\n- `onTextInput`: Write review text\n- `onAddPhoto`: Upload photos\n- `onCancel`: Discard review","x":-460,"y":620,"width":320,"height":140,"color":"4"}
	],
