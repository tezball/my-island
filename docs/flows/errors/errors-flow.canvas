		{"id":"title","type":"text","text":"# Error State Flows\n\nAll error conditions and recovery paths organized by type.\n\n**Legend:**\n- Green (5): Success/Kafka Events\n- Blue (4): UI Events/Warnings\n- Red (1): Error States\n- Yellow (3): Missing/Placeholder","x":-300,"y":-200,"width":400,"height":180,"color":"6"},

		{"id":"lbl-network-error","type":"text","text":"## Network Error\nConnection failed during request","x":20,"y":20,"width":300,"height":80},
