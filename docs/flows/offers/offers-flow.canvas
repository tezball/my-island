		{"id":"title","type":"text","text":"# Offers Flow\n\nBrowsing local supplier offers and deals near campsites.","x":0,"y":-280,"width":500,"height":120,"color":"6"},
		{"id":"legend","type":"text","text":"## Event Legend\n\n**Green (5)**: Kafka Domain Events\n**Blue (4)**: UI-Only Events\n**Red (1)**: Kafka Error Events","x":600,"y":-280,"width":280,"height":140,"color":"6"},

