		{"id":"offers-feed-ui","type":"text","text":"**UI Events:**\n- `onOfferSelect`: View supplier detail\n- `onCategoryFilter`: Filter by type\n- `onLocationFilter`: Filter by area\n- `onSearch`: Search offers\n- `onPullRefresh`: Reload offers","x":-50,"y":640,"width":320,"height":140,"color":"4"},

