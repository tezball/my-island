      "height": 500
    },
    {
      "id": "supplier-detail-event",
      "type": "text",
      "text": "**Events:**\n- `onClaimOffer`: Redeem offer\n- `onGetDirections`: Open maps\n- `onCall`: Phone supplier\n- `onWebsite`: Open website\n- `onShare`: Share offer\n- `onToggleAlert`: Enable notifications\n- `onBack`: Return to feed",
      "x": 450,
      "y": 540,
      "width": 300,
      "height": 200,
      "color": "4"
    },
