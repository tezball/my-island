      "width": 300,
      "height": 500
    },
    {
      "id": "profile-event",
      "type": "text",
      "text": "**Events:**\n- `onEditProfile`: Edit profile info\n- `onSettings`: Open settings\n- `onSupport`: Get help\n- `onLogout`: Sign out\n- `onSwitchRole`: Owner/visitor toggle",
      "x": 0,
      "y": 540,
      "width": 300,
      "height": 160,
      "color": "4"
    },
