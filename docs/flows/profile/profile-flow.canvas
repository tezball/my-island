      "width": 300,
      "height": 500
    },
    {
      "id": "edit-profile-1-event",
      "type": "text",
      "text": "**Events:**\n- `onChangePhoto`: Update avatar\n- `onNameChange`: Edit name\n- `onBioChange`: Edit bio\n- `onSave`: Save changes",
      "x": 450,
      "y": 540,
      "width": 300,
      "height": 140,
      "color": "4"
