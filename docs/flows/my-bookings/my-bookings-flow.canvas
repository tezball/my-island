{
	"nodes":[
		{"id":"title","type":"text","text":"# My Bookings Flow\n\nViewing, modifying, and managing user reservations.","x":0,"y":-280,"width":550,"height":120,"color":"6"},
		{"id":"bookings-list","type":"file","file":"flows/my-bookings/01-bookings-list.png","x":0,"y":0,"width":300,"height":500},
		{"id":"bookings-list-event","type":"text","text":"**Events:**\n- `onBookingSelect`: View booking detail\n- `onTabChange`: Switch upcoming/past\n- `onPullRefresh`: Reload bookings\n- `onEmptyState`: Show explore CTA","x":0,"y":540,"width":300,"height":140,"color":"4"},
		{"id":"bookings-past","type":"file","file":"flows/my-bookings/02-bookings-past.png","x":450,"y":0,"width":300,"height":500},
		{"id":"bookings-past-event","type":"text","text":"**Events:**\n- `onBookingSelect`: View past booking\n- `onWriteReview`: Submit review\n- `onRebook`: Book same campsite again","x":450,"y":540,"width":300,"height":120,"color":"4"},
		{"id":"booking-detail","type":"file","file":"flows/my-bookings/02b-booking-detail.png","x":900,"y":0,"width":300,"height":500},
		{"id":"booking-detail-event","type":"text","text":"**Events:**\n- `onModifyDates`: Change dates\n- `onModifyGuests`: Change guests/extras\n- `onCancel`: Cancel booking\n- `onContactHost`: Message host\n- `onViewReceipt`: See payment receipt\n- `onGetDirections`: Open maps\n- `onCheckIn`: View check-in info","x":900,"y":540,"width":300,"height":200,"color":"4"},
		{"id":"modify-dates","type":"file","file":"flows/my-bookings/03-modify-dates.png","x":0,"y":900,"width":300,"height":500},
		{"id":"modify-dates-event","type":"text","text":"**Events:**\n- `onDateSelect`: Choose new dates\n- `onCheckAvailability`: Verify availability\n- `onContinue`: Go to summary\n- `onCancel`: Discard changes","x":0,"y":1440,"width":300,"height":140,"color":"4"},
		{"id":"modify-guests","type":"file","file":"flows/my-bookings/04-modify-guests.png","x":450,"y":900,"width":300,"height":500},
		{"id":"modify-guests-event","type":"text","text":"**Events:**\n- `onGuestChange`: Update count\n- `onExtraToggle`: Add/remove extras\n- `onContinue`: Go to summary\n- `onCancel`: Discard changes","x":450,"y":1440,"width":300,"height":140,"color":"4"},
		{"id":"modify-summary","type":"file","file":"flows/my-bookings/05-modify-summary.png","x":900,"y":900,"width":300,"height":500},
		{"id":"modify-summary-event","type":"text","text":"**Events:**\n- `onConfirm`: Apply changes\n- `onPayDifference`: Process payment if more\n- `onRefund`: Process refund if less\n- `onCancel`: Discard changes","x":900,"y":1440,"width":300,"height":140,"color":"3"},
		{"id":"cancel-confirm","type":"file","file":"flows/my-bookings/06-cancel-confirm.png","x":1350,"y":0,"width":300,"height":500},
		{"id":"cancel-confirm-event","type":"text","text":"**Events:**\n- `onConfirmCancel`: Process cancellation\n- `onKeepBooking`: Return to detail\n- `onViewPolicy`: Show cancellation policy","x":1350,"y":540,"width":300,"height":120,"color":"1"},
		{"id":"cancellation-success","type":"file","file":"flows/my-bookings/07-cancellation-success.png","x":1350,"y":900,"width":300,"height":500},
