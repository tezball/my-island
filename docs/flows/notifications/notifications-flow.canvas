      "x": 0,
      "y": 0,
      "width": 300,
      "height": 500
    },
    {
      "id": "notification-center-event",
      "type": "text",
      "text": "**Events:**\n- `onNotificationTap`: View detail\n- `onMarkAllRead`: Clear unread badge\n- `onSettings`: Open preferences\n- `onPullRefresh`: Reload notifications",
      "x": 0,
      "y": 540,
      "width": 300,
      "height": 140,
      "color": "4"
    },
    {
      "id": "notifications-list",
      "type": "file",
      "file": "flows/notifications/02-notifications-list.png",
      "x": 450,
      "y": 0,
      "width": 300,
      "height": 500
    },
    {
      "id": "notifications-list-event",
      "type": "text",
      "text": "**Events:**\n- `onNotificationTap`: View detail\n- `onSwipeDelete`: Remove notification\n- `onFilter`: Filter by type\n- `onLoadMore`: Pagination",
      "x": 450,
      "y": 540,
      "width": 300,
      "height": 140,
      "color": "4"
    },
    {
      "id": "notification-detail",
      "type": "file",
      "file": "flows/notifications/03-notification-detail.png",
      "x": 900,
      "y": 0,
      "width": 300,
      "height": 500
    },
    {
      "id": "notification-detail-event",
      "type": "text",
      "text": "**Events:**\n- `onAction`: Perform CTA action\n- `onDismiss`: Mark as read\n- `onNavigate`: Go to related content\n- `onBack`: Return to list",
      "x": 900,
      "y": 540,
      "width": 300,
      "height": 140,
      "color": "4"
    },
    {
      "id": "notification-settings",
      "type": "file",
      "file": "flows/notifications/04-notification-settings.png",
      "x": 0,
      "y": 850,
      "width": 300,
      "height": 500
    },
    {
      "id": "notification-settings-event",
      "type": "text",
      "text": "**Events:**\n- `onToggle`: Enable/disable type\n- `onEmailToggle`: Email preferences\n- `onPushToggle`: Push preferences\n- `onSMSToggle`: SMS preferences\n- `onSave`: Save preferences",
      "x": 0,
      "y": 1390,
      "width": 300,
      "height": 160,
      "color": "4"
    },
    {
      "id": "related-content",
