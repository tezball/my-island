{
  "nodes": [
    {
      "id": "title",
      "type": "text",
      "text": "# Notifications Flow\n\nViewing and managing app notifications and preferences.",
      "x": 0,
      "y": -280,
      "width": 500,
      "height": 120,
      "color": "6"
    },
    {
      "id": "notification-center",
