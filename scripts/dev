#!/usr/bin/env bash
# One entrypoint for clone/run, Dev Containers, Cloud Agents, and CI.
# Humans: prefer ./scripts/app (start / stop / test).
#   ./scripts/dev up     start PostGIS + Grafana stack + catalog API + Jenkins
#   ./scripts/dev start  same as up, then open local URLs if a display exists
#   ./scripts/dev test   unit tests; stack tests if REQUIRE_STACK=1 or stack is up
#   ./scripts/dev sim    happy-path place create/list/get (see scripts/sim-place-listing.sh)
#   ./scripts/dev down
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO"

COMPOSE=(docker compose -f "$REPO/compose.yml")
# Jenkins is local house CI (WF-031). Skip in GitHub Actions stack job (SKIP_JENKINS=1).
INFRA_SERVICES=(postgres loki prometheus alertmanager grafana)
if [ "${SKIP_JENKINS:-0}" != "1" ]; then
  INFRA_SERVICES+=(jenkins)
fi

# Human tabs after start. No consumer UI yet (PRD-003).
READY_URLS=(
  http://127.0.0.1:8081/actuator/health
  http://127.0.0.1:8081/api/v1/places
  http://127.0.0.1:3030
  http://127.0.0.1:9091
  http://127.0.0.1:9094
)
if [ "${SKIP_JENKINS:-0}" != "1" ]; then
  READY_URLS+=(http://127.0.0.1:8085)
fi

usage() {
  cat <<'EOF'
Usage: ./scripts/dev <command>

  start     Start the stack, open local URLs if a display exists, print a ready summary
  stop      Stop the stack
  up        Start the Compose stack (PostGIS, Grafana, Loki, Prometheus, Alertmanager, catalog API, Jenkins)
  down      Stop the stack (no extra message)
  ps        Compose status
  test      Run pytest (same path as CI)
  sim       Happy-path catalog create→list→get (no chaos). Same as ./scripts/sim-place-listing.sh
  wait      Wait until Grafana answers /api/health
  config    Validate compose.yml (and chaos overlay)

Humans: ./scripts/app start | stop | test | help

Environment:
  REQUIRE_STACK=1          Fail if Grafana/Postgres are not reachable (CI sets this)
  DEV_TEST_IN_WORKSPACE=1  Run pytest inside the workspace image (CI stack job)
  SKIP_JENKINS=1           Do not start Jenkins (GHA stack job sets this)
  JENKINS_GITHUB_TOKEN     GitHub PAT for local Jenkins PR polling (optional; see .env.example)

Catalog API (after up): http://127.0.0.1:8081
Jenkins (after up):      http://127.0.0.1:8085  (admin / admin unless .env overrides)
If Postgres was created before PostGIS (or with Hub postgis/postgis alpine), recreate volumes: docker compose down -v && ./scripts/dev up
Chaos Monkey (not default): docker compose -f compose.yml -f compose.chaos.yml --profile chaos up -d catalog --wait
EOF
}

in_workspace() {
  [ "${IN_WORKSPACE:-}" = "1" ]
}

compose_ok() {
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1
}

cmd_up() {
  # First Jenkins boot builds the image (plugins) — can take several minutes.
  "${COMPOSE[@]}" up -d "${INFRA_SERVICES[@]}" --wait --wait-timeout 600
  ensure_catalog_db
  if ! "${COMPOSE[@]}" up -d catalog --wait --wait-timeout 300; then
    echo "catalog did not become healthy. If this laptop had postgres:17-alpine or Hub postgis/postgis alpine data, run:" >&2
    echo "  docker compose down -v && ./scripts/dev up" >&2
    return 1
  fi
  ensure_catalog_reader_grants
  cmd_wait
}

ensure_catalog_db() {
  local exists
  exists="$("${COMPOSE[@]}" exec -T postgres \
    psql -U ops -d ops -Atqc "SELECT 1 FROM pg_database WHERE datname='catalog'" | tr -d '[:space:]')"
  if [ "$exists" != "1" ]; then
    echo "creating database catalog"
    "${COMPOSE[@]}" exec -T postgres psql -U ops -d ops -c "CREATE DATABASE catalog"
  fi
}

# Re-apply catalog SELECT grants on existing volumes (initdb scripts run once).
ensure_catalog_reader_grants() {
  echo "applying catalog ops_reader SELECT grants"
  "${COMPOSE[@]}" exec -T postgres \
    psql -U ops -d ops -v ON_ERROR_STOP=1 \
    -f /docker-entrypoint-initdb.d/02-catalog-reader.sql
}

cmd_down() {
  "${COMPOSE[@]}" down
}

have_gui() {
  case "$(uname -s)" in
    Darwin) command -v open >/dev/null 2>&1 ;;
    *)
      [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null 2>&1
      ;;
  esac
}

cmd_open_tabs() {
  if ! have_gui; then
    echo "No display — skipped opening browser tabs."
    return 0
  fi
  local opener url
  if [ "$(uname -s)" = Darwin ]; then
    opener=open
  else
    opener=xdg-open
  fi
  echo "Opening local URLs…"
  for url in "${READY_URLS[@]}"; do
    "$opener" "$url" >/dev/null 2>&1 || echo "Could not open $url (continuing)"
  done
}

cmd_ready() {
  cat <<'EOF'

Halfdoor stack is ready.

  Catalog health     http://127.0.0.1:8081/actuator/health
  Catalog places     http://127.0.0.1:8081/api/v1/places
  Grafana            http://127.0.0.1:3030  (admin / admin)
  Prometheus         http://127.0.0.1:9091
  Alertmanager       http://127.0.0.1:9094
  Jenkins            http://127.0.0.1:8085  (admin / admin; JCasC from ops/jenkins/)

No consumer UI yet (PRD-003). Chaos is off on this start.
GitHub PR builds: set JENKINS_GITHUB_TOKEN in .env, then recreate jenkins.
Stop:  ./scripts/app stop
Test:  ./scripts/app test
EOF
}

cmd_start() {
  cmd_up
  cmd_open_tabs
  cmd_ready
}

cmd_stop() {
  cmd_down
  echo "Stack stopped."
  echo "Start again: ./scripts/app start"
}

cmd_ps() {
  "${COMPOSE[@]}" ps
}

cmd_config() {
  "${COMPOSE[@]}" config -q
  docker compose -f "$REPO/compose.yml" -f "$REPO/compose.chaos.yml" config -q
  echo "compose.yml ok"
}

cmd_sim() {
  local sim="$REPO/ops/scripts/sim_place_listing.py"
  python3 "$sim" "$@"
}

cmd_wait() {
  local url="${GRAFANA_URL:-}"
  local candidates=()
  [ -n "$url" ] && candidates+=("$url")
  candidates+=(http://grafana:3000 http://127.0.0.1:3030)
  local i
  for i in $(seq 1 40); do
    local c
    for c in "${candidates[@]}"; do
      if curl -sf "${c}/api/health" >/dev/null 2>&1; then
        echo "Grafana ${c}"
        return 0
      fi
    done
    sleep 2
  done
  echo "Grafana did not become ready" >&2
  if compose_ok; then
    "${COMPOSE[@]}" ps >&2 || true
  fi
  return 1
}

cmd_test() {
  local extra=("$@")
  if in_workspace; then
    exec python3 -m pytest ops/tests -q "${extra[@]}"
  fi
  if [ "${DEV_TEST_IN_WORKSPACE:-}" = "1" ] && compose_ok; then
    "${COMPOSE[@]}" run --rm --no-deps \
      -e REQUIRE_STACK="${REQUIRE_STACK:-}" \
      workspace python3 -m pytest ops/tests -q "${extra[@]}"
    return
  fi
  if python3 -c "import pytest" >/dev/null 2>&1; then
    python3 -m pytest ops/tests -q "${extra[@]}"
    return
  fi
  if compose_ok; then
    "${COMPOSE[@]}" run --rm --no-deps \
      -e REQUIRE_STACK="${REQUIRE_STACK:-}" \
      workspace python3 -m pytest ops/tests -q "${extra[@]}"
    return
  fi
  echo "pytest not found. pip install -r ops/tests/requirements.txt" >&2
  return 1
}

cmd="${1:-}"
if [ $# -gt 0 ]; then
  shift
fi

case "$cmd" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  up) cmd_up ;;
  down) cmd_down ;;
  ps) cmd_ps ;;
  wait) cmd_wait ;;
  test) cmd_test "$@" ;;
  sim) cmd_sim "$@" ;;
  config) cmd_config ;;
  -h|--help|help|"") usage; [ -n "$cmd" ] || exit 1 ;;
  *) usage; echo "unknown command: $cmd" >&2; exit 1 ;;
esac
