		{
			"id": "n_goal",
			"type": "text",
			"text": "# Goal\n\nDemo **create \u2192 list \u2192 get** on Spring catalog.\nPlumbing + tests, not polish.",
			"x": -40,
			"y": -280,
			"width": 400,
			"height": 140,
			"color": "6"
		},
		{
			"id": "file_e2e",
