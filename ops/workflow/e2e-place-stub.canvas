			"x": 0,
			"y": -40,
			"width": 440,
			"height": 200
		},
		{
			"id": "file_ws",
			"type": "file",
			"file": "workshops/e2e-place-stub.md",
			"x": 0,
			"y": 180,
			"width": 440,
			"height": 80
		},
		{
			"id": "n_create",
			"type": "text",
			"text": "**POST** `/api/v1/places`\n`name` + `categorySlug` required\noptional town, countySlug, lon+lat",
			"x": 0,
			"y": 280,
			"width": 440,
			"height": 100,
			"color": "4"
		},
		{
			"id": "n_list",
			"type": "text",
			"text": "**GET** `/api/v1/places` \u2014 list includes created `id`",
			"x": 0,
			"y": 400,
			"width": 440,
			"height": 70,
			"color": "4"
		},
		{
			"id": "n_get",
			"type": "text",
			"text": "**GET** `/api/v1/places/{id}` \u2014 one or **404**",
			"x": 0,
			"y": 490,
			"width": 440,
			"height": 70,
			"color": "4"
		},
		{
			"id": "n_400",
			"type": "text",
			"text": "Missing name / unknown category \u2192 **400** not 500",
			"x": 0,
			"y": 580,
			"width": 440,
			"height": 60,
			"color": "2"
		},
		{
			"id": "n_out",
			"type": "text",
			"text": "**Out:** UI, images, visits API, partner portal, search/pagination polish, bulk import",
			"x": 0,
			"y": 660,
			"width": 440,
			"height": 80,
			"color": "1"
		},
		{
			"id": "n_stack",
			"type": "text",
			"text": "# STACK constraints\n\nJava / Spring Boot. Postgres 17 + PostGIS. Flyway.\n**Not** Next.js, FastAPI, or a second API language.\nRead `product/STACK.md` \u2014 do not rewrite it.",
			"x": 600,
			"y": -40,
			"width": 400,
			"height": 180,
			"color": "3"
		},
		{
			"id": "file_prd",
			"type": "file",
			"file": "tickets/PRD-001.md",
			"x": 600,
			"y": 160,
			"width": 400,
			"height": 120
		},
		{
			"id": "n_geo",
			"type": "text",
			"text": "Place shape = PRD-001.\n`categorySlug` seed: poi | experience | campsite | bnb.\n`countySlug` = 32 counties incl NI.\nlon+lat together \u2192 PostGIS point.",
			"x": 600,
			"y": 300,
			"width": 400,
			"height": 140,
			"color": "3"
		},
		{
			"id": "n_nobook",
			"type": "text",
			"text": "No booking / Stripe / inventory columns",
			"x": 600,
			"y": 460,
			"width": 400,
			"height": 60,
			"color": "1"
		},
		{
			"id": "n_noauth",
			"type": "text",
			"text": "**Workshop exception:** no auth on this stub.\nDo not copy into later product APIs.",
			"x": 600,
			"y": 540,
			"width": 400,
			"height": 80,
			"color": "2"
		},
		{
			"id": "n_brand",
			"type": "text",
			"text": "Public brand naming **OPEN**.\nNo Halfdoor / Inis / Ireland Stays as product name in user-facing strings.\nRepo stays `tezball/my-island`.",
			"x": 600,
			"y": 640,
			"width": 400,
			"height": 120,
			"color": "6"
		},
		{
			"id": "n_impl",
