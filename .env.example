# Copy to .env (gitignored) for local secrets. Never commit real tokens.
#   cp .env.example .env

# Jenkins (WF-031) — http://127.0.0.1:8085/
JENKINS_URL=http://127.0.0.1:8085/
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin

# GitHub PAT for multibranch PR polling + commit statuses.
# Classic: repo (+ public_repo if needed). Fine-grained: Contents read, Commit statuses read/write.
# Leave changeme until you paste a token — local-ci still works without it.
JENKINS_GITHUB_TOKEN=changeme
GITHUB_USERNAME=tezball

# Docker group id for jenkins→docker.sock (Linux). Docker Desktop Mac: 0 is fine.
# DOCKER_GID=0

# Mock-prod VPS (WF-032). Not a GitHub Environment named production.
# MOCK_PROD_HOST=changeme
# MOCK_PROD_USER=ubuntu
# MOCK_PROD_SSH_PORT=22
# MOCK_PROD_SSH_KEY_PATH=
# MOCK_PROD_REMOTE_DIR=/opt/my-island
# MOCK_PROD_URL=https://fishing-journals.com
# Public health/info (CI deploy stamp):
# MOCK_PROD_PUBLIC_HEALTH_URL=https://fishing-journals.com/actuator/health
# MOCK_PROD_PUBLIC_INFO_URL=https://fishing-journals.com/actuator/info

# Google Identity Services (same Web client as fishing-journals).
# JS origins (Google Auth Platform → Clients → Web application):
#   https://fishing-journals.com
#   https://app.fishing-journals.com
#   http://localhost
#   http://localhost:5173
# Do not list 127.0.0.1 or a production host. Runbook: docs/ops/runbooks/GOOGLE_GIS.md
# Token exchange: POST /api/auth/google  body {"idToken":"..."} — not Spring /login/oauth2/code/google
# GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=changeme
# VITE_GOOGLE_CLIENT_ID=
