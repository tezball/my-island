# Build stage - GraalVM native image compilation
FROM ghcr.io/graalvm/native-image-community:25 AS builder
WORKDIR /app

# Install Maven
RUN microdnf install -y maven && microdnf clean all

# Copy pom.xml first to cache dependencies
COPY pom.xml .

# Download dependencies (separate layer for caching)
RUN mvn dependency:go-offline -B

# Copy source code
COPY src src

# Build native image (AOT processing + native compilation)
RUN mvn -Pnative native:compile -DskipTests -B

# Runtime stage - minimal image, no JRE needed
FROM alpine:3.19
WORKDIR /app

# Install curl for healthcheck and gcompat for glibc compatibility
RUN apk add --no-cache curl gcompat

# Copy native binary from builder
COPY --from=builder /app/target/my-island-api .

# Create non-root user
RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

EXPOSE 8080

ENTRYPOINT ["./my-island-api"]
