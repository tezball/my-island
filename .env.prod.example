# =============================================================================
# My Island — Production Environment Variables
# =============================================================================
# Copy this file to .env.prod and fill in real values.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# =============================================================================

# --- Database ----------------------------------------------------------------
POSTGRES_DB=myisland
POSTGRES_USER=myisland
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# --- JWT ---------------------------------------------------------------------
# Must be at least 256 bits (32+ chars). Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand

# --- Frontend / CORS ---------------------------------------------------------
# The public URL where the site is accessed (no trailing slash)
FRONTEND_URL=http://your-vps-ip-or-domain
CORS_ALLOWED_ORIGINS=http://your-vps-ip-or-domain

# Port the web container binds to on the host (default 80)
WEB_PORT=80

# --- Email (SMTP) ------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
EMAIL_FROM=noreply@myisland.ie

# --- Stripe ------------------------------------------------------------------
STRIPE_API_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUPPLIER_PRICE_ID=price_...
STRIPE_OWNER_PRICE_ID=price_...

# Stripe redirect URLs (update with your domain)
STRIPE_SUPPLIER_SUCCESS_URL=http://your-domain/supplier?subscription=success
STRIPE_SUPPLIER_CANCEL_URL=http://your-domain/supplier?subscription=canceled
STRIPE_OWNER_SUCCESS_URL=http://your-domain/owner?subscription=success
STRIPE_OWNER_CANCEL_URL=http://your-domain/owner?subscription=canceled
STRIPE_BOOKING_SUCCESS_URL=http://your-domain/trips?payment=success
STRIPE_BOOKING_CANCEL_URL=http://your-domain/trips?payment=cancelled

# --- AI Review Moderation (optional) ----------------------------------------
# To enable AI moderation, start with the 'ai' profile:
#   docker compose -f docker-compose.prod.yml --profile ai --env-file .env.prod up -d
# The REVIEW_AI_MODERATION feature toggle must also be enabled in the admin portal.
# No extra env vars needed — moderator connects to postgres and ollama via Docker networking.
